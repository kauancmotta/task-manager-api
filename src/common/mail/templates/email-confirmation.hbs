<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Confirm your email</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #0f1117;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #e2e8f0;
      padding: 40px 16px;
    }

    .wrapper {
      max-width: 520px;
      margin: 0 auto;
    }

    .logo {
      text-align: center;
      margin-bottom: 40px;
    }

    .logo span {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: #ffffff;
    }

    .logo span em {
      font-style: normal;
      color: #6366f1;
    }

    .card {
      background-color: #1a1d27;
      border: 1px solid #2d3148;
      border-radius: 16px;
      overflow: hidden;
    }

    .card-header {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      padding: 40px 40px 32px;
    }

    .card-header h1 {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
      letter-spacing: -0.5px;
    }

    .card-header p {
      margin-top: 8px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.75);
    }

    .card-body {
      padding: 36px 40px;
    }

    .card-body p {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.7;
    }

    .btn-wrapper {
      margin: 28px 0;
      text-align: center;
    }

    .btn {
      display: inline-block;
      background-color: #6366f1;
      color: #ffffff !important;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      padding: 14px 36px;
      border-radius: 10px;
      letter-spacing: 0.1px;
    }

    .divider {
      border: none;
      border-top: 1px solid #2d3148;
      margin: 28px 0;
    }

    .token-section p {
      font-size: 13px;
      color: #64748b;
      margin-bottom: 10px;
    }

    .token-box {
      background-color: #0f1117;
      border: 1px solid #2d3148;
      border-radius: 8px;
      padding: 12px 16px;
      font-family: 'Courier New', monospace;
      font-size: 12px;
      color: #6366f1;
      word-break: break-all;
    }

    .expires {
      margin-top: 20px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #64748b;
    }

    .expires span {
      color: #f59e0b;
      font-weight: 600;
    }

    .footer {
      margin-top: 32px;
      text-align: center;
    }

    .footer p {
      font-size: 12px;
      color: #475569;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <div class="logo">
      <span>task<em>manager</em></span>
    </div>

    <div class="card">
      <div class="card-header">
        <h1>Confirm your email address</h1>
        <p>One more step to get started</p>
      </div>

      <div class="card-body">
        <p>
          Thanks for signing up. Click the button below to verify your email
          address and activate your account.
        </p>

        <div class="btn-wrapper">
          <a href="{{appUrl}}/auth/verify-email?token={{token}}" class="btn">
            Verify email address
          </a>
        </div>

        <hr class="divider" />

        <div class="token-section">
          <p>Or copy and paste this link into your browser:</p>
          <div class="token-box">{{appUrl}}/auth/verify-email?token={{token}}</div>
        </div>

        <div class="expires">
          This link expires in <span>{{expiresIn}}</span>.
        </div>
      </div>
    </div>

    <div class="footer">
      <p>
        If you didn't create an account, you can safely ignore this email.<br />
        © 2026 Task Manager. All rights reserved.
      </p>
    </div>

  </div>
</body>
</html>
