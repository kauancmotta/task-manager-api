<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email verified</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #0f1117;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #e2e8f0;
      padding: 40px 16px;
    }

    .wrapper {
      max-width: 520px;
      margin: 0 auto;
    }

    .logo {
      text-align: center;
      margin-bottom: 40px;
    }

    .logo span {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: #ffffff;
    }

    .logo span em {
      font-style: normal;
      color: #6366f1;
    }

    .card {
      background-color: #1a1d27;
      border: 1px solid #2d3148;
      border-radius: 16px;
      overflow: hidden;
    }

    .card-header {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      padding: 40px 40px 32px;
      text-align: center;
    }

    .checkmark {
      width: 56px;
      height: 56px;
      background-color: rgba(255, 255, 255, 0.15);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 28px;
    }

    .card-header h1 {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
      letter-spacing: -0.5px;
    }

    .card-header p {
      margin-top: 8px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.75);
    }

    .card-body {
      padding: 36px 40px;
    }

    .card-body > p {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.7;
    }

    .features {
      margin: 28px 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .feature-item {
      display: flex;
      align-items: center;
      gap: 12px;
      background-color: #0f1117;
      border: 1px solid #2d3148;
      border-radius: 10px;
      padding: 14px 16px;
    }

    .feature-icon {
      font-size: 18px;
      flex-shrink: 0;
    }

    .feature-text {
      font-size: 14px;
      color: #94a3b8;
    }

    .btn-wrapper {
      margin-top: 28px;
      text-align: center;
    }

    .btn {
      display: inline-block;
      background-color: #6366f1;
      color: #ffffff !important;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      padding: 14px 36px;
      border-radius: 10px;
      letter-spacing: 0.1px;
    }

    .footer {
      margin-top: 32px;
      text-align: center;
    }

    .footer p {
      font-size: 12px;
      color: #475569;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <div class="logo">
      <span>task<em>manager</em></span>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="checkmark">✓</div>
        <h1>Your email is verified</h1>
        <p>Welcome to Task Manager</p>
      </div>

      <div class="card-body">
        <p>
          Your email address has been successfully verified. Your account is
          now fully active and ready to use.
        </p>

        <div class="features">
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span class="feature-text">Create and manage your tasks</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span class="feature-text">Organize with categories and priorities</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span class="feature-text">Collaborate by assigning tasks to teammates</span>
          </div>
        </div>

        <div class="btn-wrapper">
          <a href="{{appUrl}}" class="btn">Go to dashboard</a>
        </div>
      </div>
    </div>

    <div class="footer">
      <p>
        © 2026 Task Manager. All rights reserved.
      </p>
    </div>

  </div>
</body>
</html>
