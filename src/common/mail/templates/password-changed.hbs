<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password changed</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #0f1117;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #e2e8f0;
      padding: 40px 16px;
    }

    .wrapper {
      max-width: 520px;
      margin: 0 auto;
    }

    .logo {
      text-align: center;
      margin-bottom: 40px;
    }

    .logo span {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: #ffffff;
    }

    .logo span em {
      font-style: normal;
      color: #6366f1;
    }

    .card {
      background-color: #1a1d27;
      border: 1px solid #2d3148;
      border-radius: 16px;
      overflow: hidden;
    }

    .card-header {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      padding: 40px 40px 32px;
    }

    .card-header h1 {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
      letter-spacing: -0.5px;
    }

    .card-header p {
      margin-top: 8px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.8);
    }

    .card-body {
      padding: 36px 40px;
    }

    .card-body > p {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.7;
    }

    .info-row {
      margin: 28px 0;
      background-color: #0f1117;
      border: 1px solid #2d3148;
      border-radius: 10px;
      padding: 20px;
    }

    .info-row p {
      font-size: 13px;
      color: #64748b;
      margin-bottom: 4px;
    }

    .info-row strong {
      font-size: 15px;
      color: #e2e8f0;
      font-weight: 600;
    }

    .divider {
      border: none;
      border-top: 1px solid #2d3148;
      margin: 28px 0;
    }

    .warning {
      background-color: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 13px;
      color: #fca5a5;
      line-height: 1.6;
    }

    .warning a {
      color: #f87171;
      text-decoration: underline;
    }

    .footer {
      margin-top: 32px;
      text-align: center;
    }

    .footer p {
      font-size: 12px;
      color: #475569;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <div class="logo">
      <span>task<em>manager</em></span>
    </div>

    <div class="card">
      <div class="card-header">
        <h1>Password changed</h1>
        <p>Your account password was updated</p>
      </div>

      <div class="card-body">
        <p>
          This is a confirmation that the password for your account has been
          successfully changed.
        </p>

        <div class="info-row">
          <p>Changed at</p>
          <strong>{{changedAt}}</strong>
        </div>

        <hr class="divider" />

        <div class="warning">
          If you didn't make this change, please
          <a href="{{appUrl}}/auth/forgot-password">reset your password immediately</a>
          and contact support.
        </div>
      </div>
    </div>

    <div class="footer">
      <p>
        This is an automated security notification.<br />
        © 2026 Task Manager. All rights reserved.
      </p>
    </div>
  </div>
</body>
</html>
