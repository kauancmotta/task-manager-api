<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset your password</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #0f1117;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #e2e8f0;
      padding: 40px 16px;
    }

    .wrapper {
      max-width: 520px;
      margin: 0 auto;
    }

    .logo {
      text-align: center;
      margin-bottom: 40px;
    }

    .logo span {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: #ffffff;
    }

    .logo span em {
      font-style: normal;
      color: #6366f1;
    }

    .card {
      background-color: #1a1d27;
      border: 1px solid #2d3148;
      border-radius: 16px;
      overflow: hidden;
    }

    .card-header {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      padding: 40px 40px 32px;
    }

    .card-header h1 {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
      letter-spacing: -0.5px;
    }

    .card-header p {
      margin-top: 8px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.8);
    }

    .card-body {
      padding: 36px 40px;
    }

    .card-body > p {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.7;
    }

    .otp-wrapper {
      margin: 32px 0;
      text-align: center;
    }

    .otp-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #64748b;
      margin-bottom: 12px;
    }

    .otp-code {
      display: inline-block;
      background-color: #0f1117;
      border: 2px solid #f59e0b;
      border-radius: 12px;
      padding: 16px 40px;
      font-size: 36px;
      font-weight: 800;
      letter-spacing: 8px;
      color: #f59e0b;
      font-family: 'Courier New', monospace;
    }

    .expires {
      margin-top: 24px;
      text-align: center;
      font-size: 13px;
      color: #64748b;
    }

    .expires span {
      color: #f59e0b;
      font-weight: 600;
    }

    .divider {
      border: none;
      border-top: 1px solid #2d3148;
      margin: 28px 0;
    }

    .warning {
      background-color: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 13px;
      color: #fca5a5;
      line-height: 1.6;
    }

    .footer {
      margin-top: 32px;
      text-align: center;
    }

    .footer p {
      font-size: 12px;
      color: #475569;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <div class="logo">
      <span>task<em>manager</em></span>
    </div>

    <div class="card">
      <div class="card-header">
        <h1>Reset your password</h1>
        <p>Use the code below to set a new password</p>
      </div>

      <div class="card-body">
        <p>
          We received a request to reset your password. Enter the code below
          in the app to continue.
        </p>

        <div class="otp-wrapper">
          <div class="otp-label">Your verification code</div>
          <div class="otp-code">{{otp}}</div>
        </div>

        <div class="expires">
          This code expires in <span>{{expiresIn}}</span>.
        </div>

        <hr class="divider" />

        <div class="warning">
          If you didn't request a password reset, ignore this email.
          Your password will remain unchanged.
        </div>
      </div>
    </div>

    <div class="footer">
      <p>
        For security reasons, never share this code with anyone.<br />
        © 2026 Task Manager. All rights reserved.
      </p>
    </div>

  </div>
</body>
</html>
